#!/usr/bin/expect -f
set timeout -1
spawn bash -c "ssh -o StrictHostKeyChecking=no root@178.104.127.220 << 'SSH_EOF'
docker exec -i supabase-db psql -U postgres -d postgres << 'SQL_EOF'

-- 1. Create Wrapper Functions in onlineclass_customization to be called by global triggers
CREATE OR REPLACE FUNCTION onlineclass_customization.handle_new_user_wrapper() 
RETURNS trigger AS \$\$
BEGIN
  PERFORM onlineclass_customization.handle_new_user();
  RETURN NEW;
END;
\$\$ LANGUAGE plpgsql SECURITY DEFINER;

CREATE OR REPLACE FUNCTION onlineclass_customization.handle_new_user_role_wrapper() 
RETURNS trigger AS \$\$
BEGIN
  PERFORM onlineclass_customization.handle_new_user_role();
  RETURN NEW;
END;
\$\$ LANGUAGE plpgsql SECURITY DEFINER;

CREATE OR REPLACE FUNCTION onlineclass_customization.handle_new_user_settings_wrapper() 
RETURNS trigger AS \$\$
BEGIN
  PERFORM onlineclass_customization.handle_new_user_settings();
  RETURN NEW;
END;
\$\$ LANGUAGE plpgsql SECURITY DEFINER;

-- 2. Create the specific triggers on auth.users
DROP TRIGGER IF EXISTS on_auth_user_created_onlineclass ON auth.users;
CREATE TRIGGER on_auth_user_created_onlineclass
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION onlineclass_customization.handle_new_user_wrapper();

DROP TRIGGER IF EXISTS on_auth_user_created_role_onlineclass ON auth.users;
CREATE TRIGGER on_auth_user_created_role_onlineclass
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION onlineclass_customization.handle_new_user_role_wrapper();

DROP TRIGGER IF EXISTS on_auth_user_created_settings_onlineclass ON auth.users;
CREATE TRIGGER on_auth_user_created_settings_onlineclass
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION onlineclass_customization.handle_new_user_settings_wrapper();

SQL_EOF
SSH_EOF"
expect "password:"
send "voibVmIdk9DqPMmZ\r"
expect eof
